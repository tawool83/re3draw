{
  "name": "@re3draw/viewer",
  "version": "0.1.0",
  "description": "Three.js + Spark viewer for re3draw splats, shared by the web SDK and the Flutter WebView",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/re3draw-viewer.js",
  "module": "./dist/re3draw-viewer.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/re3draw-viewer.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --mode embed && tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sparkjsdev/spark": "^2.2.0"
  },
  "peerDependencies": {
    "three": ">=0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright": "^1.63.0",
    "three": "^0.186.1",
    "typescript": "^5.7.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
